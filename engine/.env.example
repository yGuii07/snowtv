SNOW_DATA_DIR=./data
SNOW_API_TOKEN=
SNOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SNOW_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$
SNOW_PERFORMANCE_PROFILE=auto
SNOW_WORKER_CONCURRENCY=1
SNOW_WHISPER_MODEL=auto
SNOW_WHISPER_DEVICE=auto
SNOW_WHISPER_COMPUTE_TYPE=auto
SNOW_WHISPER_CPU_THREADS=0
SNOW_LLM_PROVIDER=heuristic
SNOW_LLM_MODEL=
SNOW_LLM_API_KEY=
SNOW_LLM_BASE_URL=https://api.openai.com/v1
SNOW_VIDEO_ENCODER=auto
SNOW_VIDEO_PRESET=auto
SNOW_ANALYSIS_WIDTH=0
SNOW_CACHE_ENABLED=true
SNOW_CACHE_DIR=
SNOW_YTDLP_FORMAT=bv*+ba/b
SNOW_YTDLP_FALLBACK_FORMAT=b[height<=1080][ext=mp4]/b[height<=1080]/b/bv*+ba
SNOW_YTDLP_FALLBACK_PLAYER_CLIENTS=default,-web_safari
SNOW_YTDLP_JS_RUNTIME=auto
SNOW_YTDLP_JS_RUNTIME_PATH=
SNOW_YTDLP_REMOTE_COMPONENTS=false
SNOW_MAX_UPLOAD_MB=4096
SNOW_MAX_VIDEO_MINUTES=240
